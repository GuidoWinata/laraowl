{
    auto_https off
}

:80 {
    root * /usr/share/caddy/html/public

    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    request_body {
        max_size 100MB
    }

    handle_path /storage/* {
        root * /usr/share/caddy/html/storage/app/public
        file_server
        header Cache-Control "public, max-age=31536000"
    }

    # WebSocket Laravel Reverb
    handle /app* {
        reverse_proxy reverb:8080
    }

    php_fastcgi app:9000 {
        # Traefik menangani HTTPS di depan Caddy
        env HTTPS on
    }

    file_server

    log {
        output stdout
        format console
    }
}